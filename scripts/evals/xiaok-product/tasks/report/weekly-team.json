{
  "taskId": "prod:report:weekly-team",
  "category": "report",
  "title": "软件团队一周工作复盘报告（虚构示例数据）",
  "artifactSystem": "A",
  "turns": [
    {
      "ordinal": 1,
      "prompt": "帮我完成「软件团队一周工作复盘报告（虚构示例数据）」：请调研并输出结构化中文报告，必须包含以下章节：进展、问题、风险、结论。要求正文不少于 800 字，并把最终报告保存为 Markdown 文件。"
    }
  ],
  "expectations": {
    "artifactType": "report",
    "mustExist": true,
    "artifactMatch": {
      "kindAnyOf": [
        "text",
        "html"
      ],
      "extensionAnyOf": [
        ".md",
        ".html"
      ]
    },
    "structure": {
      "minSections": 4,
      "requiredSectionKeywords": [
        "进展",
        "问题",
        "风险",
        "结论"
      ],
      "minChars": 800
    },
    "projectCreatedOnly": false,
    "forbiddenAgentTools": [
      "scheduled_task_cancel"
    ]
  },
  "timeoutMs": 600000,
  "passK": 3,
  "notes": "结构达标 ≠ 内容质量；人工抽检时关注论据真实性。"
}
