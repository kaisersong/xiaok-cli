import {readFileSync,existsSync,mkdtempSync,rmSync} from 'node:fs';import {tmpdir} from 'node:os';import {join} from 'node:path';import {runInThisContext} from 'node:vm';import ts from 'typescript';import {TimedActionStore} from '../../../electron/timed-action-store.ts';import {TimedActionService} from '../../../electron/timed-action-service.ts';
