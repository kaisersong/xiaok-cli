import {mkdtempSync,rmSync} from 'node:fs';import {tmpdir} from 'node:os';import {join} from 'node:path';import {createKbStoreSqlite} from '../../../electron/kb-store-sqlite.js';
const own=mkdtempSync(join(tmpdir(),'knowledge-owner-controls-'));const controls:Array<{name:string;pass:boolean;reads?:number;sqlCalls?:number;error?:string}>=[];
const input=()=>({name:'Own collection',embeddingModelId:'owned',embeddingDim:384});
const snapshot=(db:any)=>JSON.stringify(['collections','sources','chunks','meetings'].map(table=>db.prepare('SELECT * FROM '+table+' ORDER BY id').all()));
const methods=['createCollection','renameCollection','deleteCollection','addSource','ensureAssistantSource','claimSourceContentHash','deleteSource','retrySource','updateSourceParseResult','insertChunks','markChunkEmbedded','markChunkFailed','createMeeting','updateMeeting'] as const;
try{for(const method of methods){const store=createKbStoreSqlite(join(own,method+'.sqlite'));try{const col=(store.createCollection as Function)(input(),'user');const source=store.addSource({collectionId:col.id,kind:'paste',title:'Own protected source'},'user');const chunks=(store.insertChunks as Function)(source.id,[{idx:0,text:'Own body',charStart:0,charEnd:8}],'user');const meeting=(store.createMeeting as Function)({status:'recording',startedAt:1},'user');const db=store._db as any,before=snapshot(db);let reads=0,sqlCalls=0;const poison=new Proxy({}, {get(){reads++;throw Error('missing source accessed input');},ownKeys(){reads++;throw Error('missing source enumerated input');}});const args:Record<string,unknown[]>={createCollection:[poison,undefined],renameCollection:[col.id,poison,undefined,undefined],deleteCollection:[col.id,undefined],addSource:[poison,undefined],ensureAssistantSource:[poison,undefined],claimSourceContentHash:[source.id,poison,undefined],deleteSource:[source.id,undefined],retrySource:[source.id,undefined],updateSourceParseResult:[source.id,poison,undefined],insertChunks:[source.id,poison,undefined],markChunkEmbedded:[chunks[0].id,undefined],markChunkFailed:[chunks[0].id,poison,undefined],createMeeting:[poison,undefined],updateMeeting:[meeting.id,poison,undefined]};const prepare=db.prepare;db.prepare=function(...a:unknown[]){sqlCalls++;return Reflect.apply(prepare,this,a);};let error='';try{Reflect.apply(store[method] as Function,store,args[method]);}catch(e){error=(e as Error).message;}finally{db.prepare=prepare;}const denied=/request source|user_only|source.*required/i.test(error);controls.push({name:method+' missing source denies before input and SQL',pass:denied&&reads===0&&sqlCalls===0&&snapshot(db)===before,reads,sqlCalls,error});}finally{store.close();}}
const store=createKbStoreSqlite(join(own,'metadata.sqlite'));try{const col=(store.createCollection as Function)(input(),'user');const agent=store.addSource({collectionId:col.id,kind:'paste',title:'Own agent pending'},'agent');const before=snapshot(store._db);let error='';try{store.updateSourceParseResult(agent.id,{parseStatus:'failed',metadata:{createdBy:'user'}},'agent');}catch(e){error=(e as Error).message;}controls.push({name:'agent parse metadata cannot become user authority',pass:!!error&&snapshot(store._db)===before,error});}finally{store.close();}
process.stdout.write('KNOWLEDGE_OWNER_FACTS:'+JSON.stringify({controls,methods,ownDataOnly:true,actualStore:true})+'\n');}finally{rmSync(own,{recursive:true,force:true});}
