{
  "appId": "com.xiaok.desktop",
  "productName": "xiaok",
  "npmRebuild": false,
  "protocols": [
    {
      "name": "xiaok intent-broker protocol",
      "schemes": [
        "intent-broker"
      ]
    }
  ],
  "directories": {
    "output": "release"
  },
  "afterPack": "scripts/after-pack.cjs",
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/@yunzhijia/cli/**",
    "**/node_modules/nodejieba/**",
    "dist/main/desktop/electron/office-parser-worker.mjs",
    "**/node_modules/@firecrawl/anydoc/**",
    "**/node_modules/@firecrawl/anydoc-*/**",
    "dist/main/src/runtime/verification/native/**"
  ],
  "extraResources": [
    {
      "from": "../data/yzj-cli",
      "to": "yzj-cli"
    },
    {
      "from": "../data/skills/yzj-cli",
      "to": "skills/yzj-cli"
    },
    {
      "from": "../data/skills/dingtalk-cli",
      "to": "skills/dingtalk-cli"
    },
    {
      "from": "../data/skills/feishu-cli",
      "to": "skills/feishu-cli"
    },
    {
      "from": "../data/skills/wecom-cli",
      "to": "skills/wecom-cli"
    },
    {
      "from": "resources/room-workspace-protocol.json",
      "to": "room-workspace-protocol.json"
    },
    {
      "from": "../../kswarm/src",
      "to": "services/kswarm/src",
      "filter": [
        "**/*.js",
        "**/*.json",
        "!**/node_modules/**"
      ]
    },
    {
      "from": "../../kswarm/scripts",
      "to": "services/kswarm/scripts",
      "filter": [
        "**/*.js",
        "!**/node_modules/**",
        "!**/auto-worker.js"
      ]
    },
    {
      "from": "overrides/kswarm/windows-xiaok-launch.js",
      "to": "services/kswarm/scripts/windows-xiaok-launch.js"
    },
    {
      "from": ".generated/kswarm/scripts/auto-worker.js",
      "to": "services/kswarm/scripts/auto-worker.js"
    },
    {
      "from": "../../kswarm/package.json",
      "to": "services/kswarm/package.json"
    },
    {
      "from": "../../kswarm/node_modules/ws",
      "to": "services/kswarm/node_modules/ws",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../intent-broker/src",
      "to": "services/intent-broker/src",
      "filter": [
        "**/*.js",
        "**/*.json",
        "!**/node_modules/**"
      ]
    },
    {
      "from": "../../intent-broker/package.json",
      "to": "services/intent-broker/package.json"
    },
    {
      "from": "../../intent-broker/bin",
      "to": "services/intent-broker/bin",
      "filter": [
        "**/*.js"
      ]
    },
    {
      "from": "../../intent-broker/adapters",
      "to": "services/intent-broker/adapters",
      "filter": [
        "**/*",
        "!**/node_modules/**",
        "!**/.env",
        "!**/.env.*"
      ]
    },
    {
      "from": "../../intent-broker/node_modules/ws",
      "to": "services/intent-broker/node_modules/ws",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-report-creator",
      "to": "bundled-plugins/kai-report-creator",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "mcp-servers/report-renderer/dist/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-slide-creator",
      "to": "bundled-plugins/kai-slide-creator",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "references/**/*",
        "schemas/**/*",
        "themes/**/*",
        "demos/**/*",
        "vendor-manifest.json",
        "mcp-servers/slide-renderer/**/*.py",
        "bundled-wheels/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/cua-computer-use",
      "to": "bundled-plugins/cua-computer-use",
      "filter": [
        "plugin.json",
        "skills/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-infinity-canvas",
      "to": "bundled-plugins/kai-infinity-canvas",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "scripts/**/*",
        "mcp-servers/canvas-server/**/*",
        "node_modules/fractional-indexing-jittered/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-meeting-assistant",
      "to": "bundled-plugins/kai-meeting-assistant",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "mcp-servers/meeting-transcriber/**/*.py",
        "mcp-servers/meeting-transcriber/requirements.txt"
      ]
    },
    {
      "from": "app-update.yml",
      "to": "."
    },
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "../native/broker-authority-source/build/Release",
      "to": "services/intent-broker/runtime",
      "filter": [
        "xiaok-source-runtime.cjs",
        "source-runtime-manifest.json"
      ]
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "kaisersong",
    "repo": "xiaok-cli",
    "releaseType": "release"
  },
  "mac": {
    "target": [
      "dir",
      "dmg",
      "zip"
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "notarize": true,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Xiaok uses the microphone to record meetings locally for transcription and summaries."
    },
    "extraResources": [
      {
        "from": "../native/kswarm-authority-source/build/Release",
        "to": "services/kswarm/runtime",
        "filter": [
          "protected_sqlite.node",
          "index.cjs",
          "original-authority-sqlite.cjs",
          "xiaok-source-runtime.cjs",
          "node_modules/**"
        ]
      },
      {
        "from": "../native/kswarm-authority-source/build/Release/kswarm-child-launcher",
        "to": "native/kswarm-child-launcher"
      },
      {
        "from": "../native/broker-authority-source/build/Release",
        "to": "services/intent-broker/runtime",
        "filter": [
          "protected_sqlite.node",
          "index.cjs",
          "original-authority-sqlite.cjs",
          "artifact-manifest.json"
        ]
      },
      {
        "from": "../native/broker-authority-source/build/Release/broker-child-launcher",
        "to": "native/broker-child-launcher"
      }
    ]
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName}-setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-portable-${version}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ]
  }
}
