{
  "appId": "com.xiaok.desktop",
  "productName": "xiaok",
  "npmRebuild": false,
  "protocols": [
    {
      "name": "xiaok intent-broker protocol",
      "schemes": [
        "intent-broker"
      ]
    },
    {
      "name": "xiaok context references",
      "schemes": [
        "xiaok"
      ]
    }
  ],
  "directories": {
    "output": "release"
  },
  "afterPack": "scripts/after-pack.cjs",
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/nodejieba/**",
    "dist/main/desktop/electron/office-parser-worker.mjs",
    "**/node_modules/@firecrawl/anydoc/**",
    "**/node_modules/@firecrawl/anydoc-*/**"
  ],
  "extraResources": [
    {
      "from": "resources/room-workspace-protocol.json",
      "to": "room-workspace-protocol.json"
    },
    {
      "from": "../../kswarm/src",
      "to": "services/kswarm/src",
      "filter": [
        "**/*.js",
        "**/*.json",
        "!**/node_modules/**"
      ]
    },
    {
      "from": "../../kswarm/scripts",
      "to": "services/kswarm/scripts",
      "filter": [
        "**/*.js",
        "!**/node_modules/**",
        "!**/auto-worker.js"
      ]
    },
    {
      "from": "overrides/kswarm/windows-xiaok-launch.js",
      "to": "services/kswarm/scripts/windows-xiaok-launch.js"
    },
    {
      "from": ".generated/kswarm/scripts/auto-worker.js",
      "to": "services/kswarm/scripts/auto-worker.js"
    },
    {
      "from": "../../kswarm/package.json",
      "to": "services/kswarm/package.json"
    },
    {
      "from": "../../kswarm/node_modules/ws",
      "to": "services/kswarm/node_modules/ws",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../intent-broker/src",
      "to": "services/intent-broker/src",
      "filter": [
        "**/*.js",
        "**/*.json",
        "!**/node_modules/**"
      ]
    },
    {
      "from": "../../intent-broker/package.json",
      "to": "services/intent-broker/package.json"
    },
    {
      "from": "../../intent-broker/bin",
      "to": "services/intent-broker/bin",
      "filter": [
        "**/*.js"
      ]
    },
    {
      "from": "../../intent-broker/adapters",
      "to": "services/intent-broker/adapters",
      "filter": [
        "**/*",
        "!**/node_modules/**",
        "!**/.env",
        "!**/.env.*"
      ]
    },
    {
      "from": "../../intent-broker/node_modules/ws",
      "to": "services/intent-broker/node_modules/ws",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-report-creator",
      "to": "bundled-plugins/kai-report-creator",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "mcp-servers/report-renderer/dist/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-slide-creator",
      "to": "bundled-plugins/kai-slide-creator",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "references/**/*",
        "schemas/**/*",
        "themes/**/*",
        "demos/**/*",
        "vendor-manifest.json",
        "mcp-servers/slide-renderer/**/*.py",
        "bundled-wheels/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/cua-computer-use",
      "to": "bundled-plugins/cua-computer-use",
      "filter": [
        "plugin.json",
        "skills/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-infinity-canvas",
      "to": "bundled-plugins/kai-infinity-canvas",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "scripts/**/*",
        "mcp-servers/canvas-server/**/*",
        "node_modules/fractional-indexing-jittered/**/*"
      ]
    },
    {
      "from": "../../kai-xiaok-plugins/plugins/kai-meeting-assistant",
      "to": "bundled-plugins/kai-meeting-assistant",
      "filter": [
        "plugin.json",
        "skills/**/*",
        "mcp-servers/meeting-transcriber/**/*.py",
        "mcp-servers/meeting-transcriber/requirements.txt"
      ]
    },
    {
      "from": "app-update.yml",
      "to": "."
    },
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "../services/continuity-sync/src",
      "to": "services/continuity-sync/src",
      "filter": [
        "**/*.mjs"
      ]
    },
    {
      "from": "../services/continuity-sync/package.json",
      "to": "services/continuity-sync/package.json"
    },
    {
      "from": "../services/continuity-device/src",
      "to": "services/continuity-device/src",
      "filter": [
        "**/*.mjs"
      ]
    },
    {
      "from": "../services/continuity-device/package.json",
      "to": "services/continuity-device/package.json"
    },
    {
      "from": "../services/continuity-sync/node_modules/libsodium",
      "to": "services/continuity-sync/node_modules/libsodium",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../services/continuity-sync/node_modules/libsodium-wrappers",
      "to": "services/continuity-sync/node_modules/libsodium-wrappers",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../services/continuity-device/node_modules/@napi-rs/keyring",
      "to": "services/continuity-device/node_modules/@napi-rs/keyring",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../services/continuity-device/node_modules/@napi-rs/keyring-darwin-arm64",
      "to": "services/continuity-device/node_modules/@napi-rs/keyring-darwin-arm64",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/continuity-auth/darwin-arm64/codex-app-server",
      "to": "continuity-auth/darwin-arm64/codex-app-server"
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "kaisersong",
    "repo": "xiaok-cli",
    "releaseType": "release"
  },
  "mac": {
    "target": [
      "dir",
      "dmg",
      "zip"
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "notarize": true,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Xiaok uses the microphone to record meetings locally for transcription and summaries."
    }
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName}-setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-portable-${version}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ]
  }
}
