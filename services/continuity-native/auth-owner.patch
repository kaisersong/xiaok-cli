+        "SYNTHETIC_BEFORE_CANARY",
+    ));
+    let receiver = manager.auth_change_state_receiver();
+    let held_watch = receiver.borrow();
+    let writer_manager = manager.clone();
+    let writer = thread::spawn(move || {
+        writer_manager.set_cached_auth(Some(managed(
+            "user-b",
+            "account-b",
+            "SYNTHETIC_AFTER_CANARY",
+        )))
+    });
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while manager.inner.try_read().is_ok() {
+        assert!(Instant::now() < deadline);
+        thread::yield_now();
+    }
+    let (tx, rx) = mpsc::channel();
+    let reader_manager = manager.clone();
+    let reader = thread::spawn(move || {
+        tx.send(reader_manager.xiaok_managed_auth_snapshot())
+            .unwrap()
+    });
+    assert!(matches!(
+        rx.recv_timeout(Duration::from_millis(30)),
+        Err(mpsc::RecvTimeoutError::Timeout)
+    ));
+    drop(held_watch);
+    assert!(writer.join().unwrap());
+    let result = rx.recv_timeout(Duration::from_secs(5)).unwrap().unwrap();
+    reader.join().unwrap();
+    assert_eq!(result.account_id(), "account-b");
