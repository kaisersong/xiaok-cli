+fn actual_pipe() -> (std::os::fd::OwnedFd, std::os::fd::OwnedFd) {
+    use std::os::fd::FromRawFd;
+    let mut fds = [-1; 2];
+    assert_eq!(unsafe { libc::pipe(fds.as_mut_ptr()) }, 0);
+    unsafe {
+        (
+            std::os::fd::OwnedFd::from_raw_fd(fds[0]),
+            std::os::fd::OwnedFd::from_raw_fd(fds[1]),
+        )
+    }
+}
+
+#[test]
+fn actual_nonblocking_read_zero_closes_the_same_owner_before_any_next_write() {
+    let (input, input_writer) = actual_pipe();
+    let (output_reader, output) = actual_pipe();
+    validate_fd(input.as_raw_fd()).unwrap();
+    validate_fd(output.as_raw_fd()).unwrap();
+    let io = VerifiedStdio {
+        input: input.as_raw_fd(),
+        output: output.as_raw_fd(),
+    };
+    let owner = AuthOwnerConnection::new();
+    owner.open_stdio(&io).unwrap();
+    drop(input_writer);
+    assert_eq!(io.read_stdin(&mut [0u8; 8], &owner).unwrap(), 0);
+    assert!(owner.closed.is_cancelled());
+    let mut offset = 0;
+    assert!(matches!(
+        public_step(&io, &owner, b"must-not-write\n", &mut offset),
+        WriteStep::Closed
+    ));
+    assert_eq!(offset, 0);
+    validate_fd(output_reader.as_raw_fd()).unwrap();
+    let mut bytes = [0u8; 32];
+    assert_eq!(
+        unsafe {
+            libc::read(
+                output_reader.as_raw_fd(),
+                bytes.as_mut_ptr().cast(),
+                bytes.len(),
+            )
+        },
+        -1
+    );
+    assert_eq!(io::Error::last_os_error().kind(), io::ErrorKind::WouldBlock);
+}
+
+#[test]
+fn unbound_owner_never_writes_but_actual_open_revoked_owner_can_write_the_fixed_public_error() {
+    let (input, _input_writer) = actual_pipe();
+    let (output_reader, output) = actual_pipe();
+    validate_fd(input.as_raw_fd()).unwrap();
+    validate_fd(output.as_raw_fd()).unwrap();
+    let io = VerifiedStdio {
+        input: input.as_raw_fd(),
+        output: output.as_raw_fd(),
+    };
+    let owner = AuthOwnerConnection::new();
+    let mut offset = 0;
+    assert!(matches!(
+        public_step(&io, &owner, b"blocked", &mut offset),
+        WriteStep::Closed
+    ));
+    owner.open_stdio(&io).unwrap();
+    owner.revoke_exports();
+    let frame = b"{\"error\":\"xiaok_auth_request_id_rejected\"}\n";
+    assert!(matches!(
+        public_step(&io, &owner, frame, &mut offset),
+        WriteStep::Complete
+    ));
+    assert!(!owner.closed.is_cancelled());
+    let mut read = vec![0u8; frame.len()];
+    assert_eq!(
+        unsafe {
+            libc::read(
+                output_reader.as_raw_fd(),
+                read.as_mut_ptr().cast(),
+                read.len(),
+            )
+        },
+        frame.len() as isize
+    );
+    assert_eq!(read, frame);
+    owner.close_physical();
+    assert!(owner.open_stdio(&io).is_err());
+}
