+            }
+            vault.root.sync_all().map_err(|_| unavailable())?;
+            let actual = vault.observe_auth()?;
+            let Version::Present {
+                id,
+                auth: observed,
+                digest,
+            } = &actual
+            else {
+                return Err(unavailable());
+            };
+            if observed != auth
+                || id.dev != initial.dev
+                || id.ino != initial.ino
+                || *digest != <[u8; 32]>::from(Sha256::digest(&encoded))
+            {
+                return Err(unavailable());
+            }
+            bump_revision(&mut state)?;
+            state.stamp.version = actual;
+            state.pending_login = None;
+            state.suspended = false;
+            vault.check_root_and_lock(&state)?;
+            *self.inner.completion.lock().map_err(|_| unavailable())? = Some(state.stamp.clone());
+            Ok(())
+        })();
+        if result.is_err() {
+            state.poisoned = true;
+            // Clean only the exact temp inode this operation created. Rename or
+            // an unknown replacement never causes deletion of another file.
+            if let Ok(named) = at(vault.root.as_raw_fd(), &temp_name, libc::O_RDONLY)
+                && let Ok(m) = named.metadata()
+                && m.dev() == initial.dev
+                && m.ino() == initial.ino
+            {
+                if let Ok(name) = CString::new(temp_name) {
+                    unsafe {
+                        libc::unlinkat(vault.root.as_raw_fd(), name.as_ptr(), 0);
+                    }
+                }
+            }
+        }
+        result.map_err(|_| unavailable())
+    }
+    pub(crate) fn delete(&self) -> io::Result<bool> {
+        if self.inner.kind != Kind::Delete {
+            return Err(stale());
+        }
+        let vault = &self.inner.vault;
+        let mut state = vault.io.lock().map_err(|_| unavailable())?;
+        self.check_locked(&mut state)?;
+        if self.inner.consumed.swap(true, Ordering::SeqCst) {
+            return Err(stale());
+        }
+        let present = matches!(state.stamp.version, Version::Present { .. });
+        let result = (|| {
+            if present {
+                let name = CString::new(AUTH).map_err(|_| unavailable())?;
+                if unsafe { libc::unlinkat(vault.root.as_raw_fd(), name.as_ptr(), 0) } != 0 {
+                    return Err(unavailable());
+                }
+                vault.root.sync_all().map_err(|_| unavailable())?;
+            }
+            if vault.observe_auth()? != Version::Absent {
+                return Err(unavailable());
+            }
+            bump_revision(&mut state)?;
+            state.stamp.version = Version::Absent;
+            state.suspended = false;
+            state.pending_login = None;
+            vault.check_root_and_lock(&state)?;
+            Ok(present)
+        })();
+        if result.is_err() {
+            state.poisoned = true;
+        }
+        result.map_err(|_| unavailable())
+    }
+}
+
+struct BoundStorage {
+    vault: Arc<Vault>,
+}
+impl std::fmt::Debug for BoundStorage {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("XiaokBoundFileStorage([redacted])")
+    }
+}
+impl AuthStorageBackend for BoundStorage {
+    fn load(&self) -> io::Result<Option<AuthDotJson>> {
+        Ok(self.vault.load_cap()?.auth().cloned())
+    }
+    fn save(&self, _: &AuthDotJson) -> io::Result<()> {
+        Err(stale())
+    }
+    fn delete(&self) -> io::Result<bool> {
+        Err(stale())
+    }
+}
+#[derive(Debug)]
+struct DeniedStorage;
+impl AuthStorageBackend for DeniedStorage {
+    fn load(&self) -> io::Result<Option<AuthDotJson>> {
+        Err(unavailable())
+    }
+    fn save(&self, _: &AuthDotJson) -> io::Result<()> {
+        Err(unavailable())
+    }
+    fn delete(&self) -> io::Result<bool> {
+        Err(unavailable())
+    }
+}
+pub(super) fn file_backend(
+    root: &Path,
+    mode: AuthCredentialsStoreMode,
+) -> Arc<dyn AuthStorageBackend> {
+    if mode != AuthCredentialsStoreMode::File {
+        return Arc::new(DeniedStorage);
+    }
+    match lookup(root) {
+        Ok(vault) => Arc::new(BoundStorage { vault }),
+        Err(_) => Arc::new(DeniedStorage),
+    }
+}
