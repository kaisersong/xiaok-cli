+        let operation = manager.xiaok_begin_login().unwrap();
+        let (release, held) = std::sync::mpsc::channel();
+        let (started, entered) = std::sync::mpsc::channel();
+        let occupying = tokio::task::spawn_blocking(move || {
+            started.send(()).unwrap();
+            held.recv_timeout(Duration::from_secs(3)).unwrap();
+        });
+        entered.recv_timeout(Duration::from_secs(1)).unwrap();
+        let save = persist(root.path(), operation.clone(), "b", false);
+        tokio::pin!(save);
+        assert!(timeout(Duration::from_millis(20), &mut save).await.is_err());
+        operation.cancel(true);
+        release.send(()).unwrap();
+        occupying.await.unwrap();
+        assert!(
+            timeout(Duration::from_secs(1), save)
+                .await
+                .unwrap()
+                .is_err()
+        );
+        manager.xiaok_reload_checked().await.unwrap();
+        assert_eq!(
+            manager.xiaok_managed_auth_snapshot().unwrap().account_id(),
+            "account-a"
+        );
+    });
+}
