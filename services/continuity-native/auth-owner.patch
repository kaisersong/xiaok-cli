+        .arg(root.join(".xiaok-auth-vault-v1.lock"))
+        .spawn().unwrap();
+    let pid = child.id();
+    println!("owned OS lock probe PID {pid}");
+    assert!(
+        child.wait().unwrap().success(),
+        "another process must observe the real OS lock, not just the registry"
+    );
+    assert_eq!(unsafe { libc::kill(pid as i32, 0) }, -1);
+    assert_eq!(
+        std::io::Error::last_os_error().raw_os_error(),
+        Some(libc::ESRCH)
+    );
+    println!("owned OS lock probe PID {pid} reaped");
