+#[cfg(feature = "xiaok-auth-owner-only")]
+pub struct XiaokAuthSnapshotGuard<'a> {
+    _inner: std::sync::RwLockReadGuard<'a, CachedAuth>,
+    _vault: std::sync::MutexGuard<'a, super::xiaok_vault::State>,
+}
+
+#[cfg(feature = "xiaok-auth-owner-only")]
+impl AuthManager {
+    async fn xiaok_checked_from_auth_config(config: AuthConfig) -> std::io::Result<Arc<Self>> {
+        if config.auth_credentials_store_mode != AuthCredentialsStoreMode::File
+            || !config.is_login_method_allowed(ForcedLoginMethod::Chatgpt)
+        {
+            return Err(super::xiaok_vault::unavailable());
+        }
+        config
+            .validate()
+            .map_err(|_| super::xiaok_vault::unavailable())?;
+        let vault = super::xiaok_vault::lookup(&config.codex_home)?;
+        let mut manager = Self::from_loaded_auth_config(config, false, None);
+        manager.xiaok_vault = Some(vault);
+        manager.xiaok_reload_checked().await?;
+        Ok(Arc::new(manager))
+    }
+    async fn xiaok_load_checked(
+        &self,
+    ) -> std::io::Result<(Option<CodexAuth>, super::xiaok_vault::ReadCap)> {
+        let vault = self
+            .xiaok_vault
+            .as_ref()
+            .ok_or_else(super::xiaok_vault::unavailable)?;
+        let cap = vault.load_cap()?;
+        let Some(data) = cap.auth().cloned() else {
+            return Ok((None, cap));
+        };
+        let auth = CodexAuth::from_auth_dot_json(
+            &self.codex_home,
+            data,
+            AuthCredentialsStoreMode::File,
+            self.chatgpt_base_url.as_deref(),
+            self.keyring_backend_kind,
+            self.agent_identity_authapi_base_url.as_deref(),
+            &self.auth_route_config,
+        )
+        .await
+        .map_err(|_| {
+            vault.poison();
+            super::xiaok_vault::unavailable()
+        })?;
+        let forced = self
+            .forced_chatgpt_workspace_id
+            .read()
+            .map_err(|_| super::xiaok_vault::unavailable())?
+            .clone();
+        let allowed = self
+            .managed_auth_policy
+            .allowed_login_methods(self.forced_login_method, forced.as_deref());
+        let workspaces = self
+            .managed_auth_policy
+            .effective_chatgpt_workspaces(forced.as_deref());
+        validate_auth_restrictions(Some(&allowed), workspaces.as_deref(), &auth).map_err(|_| {
+            vault.poison();
+            super::xiaok_vault::unavailable()
+        })?;
+        Ok((Some(auth), cap))
+    }
+    fn xiaok_commit_checked(
+        &self,
+        auth: Option<CodexAuth>,
+        cap: super::xiaok_vault::ReadCap,
+    ) -> std::io::Result<bool> {
+        if auth
+            .as_ref()
+            .and_then(CodexAuth::get_current_auth_json)
+            .as_ref()
+            != cap.auth()
+        {
+            return Err(super::xiaok_vault::unavailable());
+        }
+        let vault = self
+            .xiaok_vault
+            .as_ref()
+            .ok_or_else(super::xiaok_vault::unavailable)?;
+        let mut inner = self
+            .inner
+            .write()
+            .map_err(|_| super::xiaok_vault::unavailable())?;
+        let (origin, file_guard) = vault.consume_cap(cap)?;
+        let origin_changed = !inner
+            .xiaok_origin
+            .as_ref()
+            .is_some_and(|old| old.same(&origin));
+        let changed = self.set_cached_auth_locked(&mut inner, auth, origin_changed);
+        inner.xiaok_origin = Some(origin);
+        drop(file_guard);
+        Ok(changed)
+    }
+    async fn xiaok_reload_checked(&self) -> std::io::Result<bool> {
+        let (auth, cap) = self.xiaok_load_checked().await?;
+        self.xiaok_commit_checked(auth, cap)
+    }
+    pub fn xiaok_begin_login(&self) -> std::io::Result<super::xiaok_vault::XiaokAuthOperation> {
+        self.xiaok_vault
+            .as_ref()
+            .ok_or_else(super::xiaok_vault::unavailable)?
+            .begin(super::xiaok_vault::Kind::Login)
+    }
+    pub fn xiaok_invalidate_auth_operations(&self) -> std::io::Result<()> {
+        self.xiaok_vault
+            .as_ref()
+            .ok_or_else(super::xiaok_vault::unavailable)?
+            .invalidate()
+    }
+    pub fn xiaok_lock_current_snapshot<'a>(
+        &'a self,
+        snapshot: &XiaokManagedAuthSnapshot,
+    ) -> std::io::Result<XiaokAuthSnapshotGuard<'a>> {
+        let inner = self
+            .inner
+            .read()
+            .map_err(|_| super::xiaok_vault::unavailable())?;
+        if !Arc::ptr_eq(&inner.xiaok_incarnation, &snapshot.incarnation)
+            || inner.change_state != snapshot.state
+            || self.xiaok_current_managed_tuple(&inner)?.pin() != snapshot.pin
+        {
+            return Err(xiaok_auth_unavailable());
+        }
+        let origin = inner
+            .xiaok_origin
+            .as_ref()
+            .ok_or_else(xiaok_auth_unavailable)?;
+        if !snapshot.origin.as_ref().is_some_and(|o| o.same(origin))
+            || inner
+                .auth
+                .as_ref()
+                .and_then(CodexAuth::get_current_auth_json)
+                .as_ref()
+                != origin.auth()
+        {
+            return Err(xiaok_auth_unavailable());
+        }
+        let vault = self
+            .xiaok_vault
+            .as_ref()
+            .ok_or_else(super::xiaok_vault::unavailable)?;
+        let file_guard = vault.lock_origin(origin)?;
+        Ok(XiaokAuthSnapshotGuard {
+            _inner: inner,
+            _vault: file_guard,
+        })
+    }
+    async fn xiaok_logout_checked(&self, revoke: bool) -> std::io::Result<bool> {
+        let vault = self
+            .xiaok_vault
+            .as_ref()
+            .ok_or_else(super::xiaok_vault::unavailable)?;
+        // This is synchronous, before the first network/queue await.
