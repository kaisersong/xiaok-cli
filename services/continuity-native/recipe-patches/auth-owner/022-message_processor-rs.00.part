+
+    #[cfg(feature = "xiaok-auth-owner-only")]
+    async fn dispatch_xiaok_auth_snapshot(
+        self: &Arc<Self>,
+        request_id: ConnectionRequestId,
+        params: Option<serde_json::Value>,
+        session: Arc<ConnectionSessionState>,
+        context: RequestContext,
+    ) -> Result<(), JSONRPCErrorError> {
+        self.xiaok_auth_connection
+            .check(request_id.connection_id, &session)?;
+        let params = crate::xiaok_auth_owner::SnapshotParams::parse(params)?;
+        let processor = Arc::clone(self);
+        let span = context.span();
+        let request = QueuedInitializedRequest::new(
+            Arc::clone(&session.rpc_gate),
+            async move {
+                let originator = AuthStorageOriginator::from_client_name(
+                    session.app_server_client_name().unwrap_or("none"),
+                );
+                let result = originator
+                    .scope(async {
+                        processor
+                            .xiaok_auth_connection
+                            .check(request_id.connection_id, &session)?;
+                        if context.cancellation.is_cancelled() {
+                            return Err(crate::xiaok_auth_owner::unavailable());
+                        }
+                        if params.refresh {
+                            // Reject missing/nonmanaged/policy-failed auth before any refresh IO.
+                            processor
+                                .xiaok_auth_manager
+                                .xiaok_managed_auth_snapshot()
+                                .map_err(|_| crate::xiaok_auth_owner::unavailable())?;
+                            processor
+                                .xiaok_auth_manager
+                                .refresh_token()
+                                .await
+                                .map_err(|_| crate::xiaok_auth_owner::unavailable())?;
+                        }
+                        let snapshot = processor
+                            .xiaok_auth_manager
+                            .xiaok_managed_auth_snapshot()
+                            .map_err(|_| crate::xiaok_auth_owner::unavailable())?;
+                        processor
+                            .outgoing
+                            .send_xiaok_auth_snapshot_checked(
+                                request_id.clone(),
+                                &context,
+                                snapshot,
+                                &processor.xiaok_auth_manager,
+                                &processor.xiaok_auth_connection,
+                                &session,
+                            )
+                            .await;
+                        Ok::<(), JSONRPCErrorError>(())
+                    })
+                    .await;
+                if let Err(error) = result {
+                    processor.outgoing.send_error(request_id, error).await;
+                }
+            }
+            .instrument(span),
+        );
+        self.request_serialization_queues
+            .enqueue(
+                RequestSerializationQueueKey::Global("account-auth"),
+                crate::request_serialization::RequestSerializationAccess::Exclusive,
+                request,
+            )
+            .await;
+        Ok(())
     }
 
