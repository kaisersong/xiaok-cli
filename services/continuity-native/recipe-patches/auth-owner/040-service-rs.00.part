     "Please log out and sign in again."
 );
 
+// Error values can carry remote bodies or parsed configuration fragments.
+// The fixed AuthOwner role never formats them into diagnostics or public errors.
+fn diagnostic(error: &impl std::fmt::Display) -> String {
+    if codex_login::XIAOK_AUTH_OWNER_ONLY {
+        "xiaok_auth_unavailable".to_owned()
+    } else {
+        error.to_string()
+    }
+}
+
+fn public_error(error: CloudConfigBundleLoadError) -> CloudConfigBundleLoadError {
+    if codex_login::XIAOK_AUTH_OWNER_ONLY {
+        CloudConfigBundleLoadError::new(error.code(), error.status_code(), "xiaok_auth_unavailable")
+    } else {
+        error
+    }
+}
+
 fn auth_identity(auth: &CodexAuth) -> (Option<String>, Option<String>) {
     (auth.get_chatgpt_user_id(), auth.get_account_id())
 }
