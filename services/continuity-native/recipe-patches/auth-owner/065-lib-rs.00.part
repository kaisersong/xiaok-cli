+    feature = "xiaok-auth-owner-only",
+    not(all(target_os = "macos", target_arch = "aarch64"))
+))]
+compile_error!("xiaok-auth-owner-only is qualified only for macOS arm64");
+#[cfg(feature = "xiaok-auth-owner-only")]
+pub use auth::{XiaokAuthOperation, initialize_xiaok_auth_vault};
 pub mod auth;
