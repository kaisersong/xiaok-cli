+#[cfg(all(test, feature = "xiaok-auth-owner-only"))]
+#[path = "xiaok_auth_outgoing_tests.rs"]
+mod xiaok_auth_outgoing_tests;
+
+// Only this original narrow sender can construct this one-shot delivery.
+// Fields are private to outgoing_message; Any is a transport, never authority.
+#[cfg(feature = "xiaok-auth-owner-only")]
+pub(super) struct AuthSnapshotDelivery {
+    snapshot: codex_login::auth::XiaokManagedAuthSnapshot,
+    manager: Arc<codex_login::AuthManager>,
+    owner: Arc<crate::xiaok_auth_owner::AuthOwnerConnection>,
+    session: Arc<crate::message_processor::ConnectionSessionState>,
+    context: RequestContext,
+    request_id: ConnectionRequestId,
+    frame: Option<Vec<u8>>,
+    offset: usize,
+}
+#[cfg(all(feature = "xiaok-auth-owner-only", unix))]
+impl AuthSnapshotDelivery {
+    pub(super) fn closed(&self) -> &tokio_util::sync::CancellationToken {
+        &self.owner.closed
+    }
