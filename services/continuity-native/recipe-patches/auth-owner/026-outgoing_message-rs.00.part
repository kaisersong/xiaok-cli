+
+// The original context map and auth-only lifetime replay reservations share
+// one original Mutex/guard. No seen-ID eviction or connection reincarnation.
+#[derive(Default)]
+struct RequestContexts {
+    active: HashMap<ConnectionRequestId, RequestContext>,
+    #[cfg(feature = "xiaok-auth-owner-only")]
+    seen: HashSet<ConnectionRequestId>,
+}
+impl std::ops::Deref for RequestContexts {
+    type Target = HashMap<ConnectionRequestId, RequestContext>;
+    fn deref(&self) -> &Self::Target {
+        &self.active
+    }
+}
+impl std::ops::DerefMut for RequestContexts {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.active
+    }
 }
 
