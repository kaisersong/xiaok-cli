+    #[cfg(feature = "xiaok-auth-owner-only")]
+    pub(crate) async fn try_register_xiaok_request_context(&self, context: RequestContext) -> bool {
+        let mut contexts = self.request_contexts.lock().await;
+        let id = &context.request_id;
+        let bounded = match &id.request_id {
+            RequestId::Integer(_) => true,
+            RequestId::String(value) => !value.is_empty() && value.len() <= 128,
+        };
+        if !bounded
+            || contexts.seen.len() >= 65_536
+            || contexts.seen.contains(id)
+            || contexts.active.contains_key(id)
+        {
+            return false;
+        }
+        contexts.seen.insert(id.clone());
+        contexts.active.insert(id.clone(), context);
+        true
+    }
+
+    #[cfg(feature = "xiaok-auth-owner-only")]
+    pub(crate) async fn send_xiaok_duplicate_error(&self, request_id: ConnectionRequestId) {
+        // The original request keeps its context. The caller already closed its
+        // original gate; this fixed reply never consumes another request.
+        let ConnectionRequestId {
+            request_id,
+            connection_id,
+        } = request_id;
+        // The id echo stays verbatim while the fixed error frame fits the
+        // bounded output budget checked at the final writer. A string ID whose
+        // echo would push the fixed frame past that budget is answered under
+        // the empty id instead: the fixed error must still be written and the
+        // connection stay alive until real EOF, not close early on an
+        // oversized frame.
+        let request_id = match request_id {
+            original @ RequestId::String(_) => {
+                let probe = OutgoingMessage::Error(OutgoingError {
+                    id: original.clone(),
+                    error: crate::xiaok_auth_owner::error("xiaok_auth_request_id_rejected"),
+                });
+                if serde_json::to_string(&probe).map_or(true, |frame| {
+                    frame.len() >= crate::xiaok_auth_stdio::MAX_FRAME
+                }) {
+                    RequestId::String(String::new())
+                } else {
+                    original
+                }
+            }
+            bounded => bounded,
+        };
+        let request_id = ConnectionRequestId {
+            request_id,
+            connection_id,
+        };
+        self.send_error_inner(
+            None,
+            request_id,
+            crate::xiaok_auth_owner::error("xiaok_auth_request_id_rejected"),
+        )
+        .await;
+    }
+
+    /// A fact at original outbound enqueue, not a promise about final stdout.
+    /// Only an original AuthManager snapshot can reach this producer.
+    #[cfg(feature = "xiaok-auth-owner-only")]
+    pub(crate) async fn send_xiaok_auth_snapshot_checked(
+        &self,
+        request_id: ConnectionRequestId,
+        expected_context: &RequestContext,
+        snapshot: codex_login::auth::XiaokManagedAuthSnapshot,
+        manager: &Arc<codex_login::AuthManager>,
+        owner: &Arc<crate::xiaok_auth_owner::AuthOwnerConnection>,
+        session: &Arc<crate::message_processor::ConnectionSessionState>,
+    ) {
+        let permit = self.sender.reserve().await;
+        let context = self.take_request_context(&request_id).await;
+        let Ok(permit) = permit else {
+            return;
+        };
+        let current = context.as_ref().is_some_and(|context| {
+            context.request_id == request_id
+                && expected_context.request_id == request_id
+                && context.xiaok_method == "xiaok/auth/snapshot"
+                && expected_context.xiaok_method == "xiaok/auth/snapshot"
+                && Arc::ptr_eq(&context.xiaok_identity, &expected_context.xiaok_identity)
+                && !context.cancellation.is_cancelled()
+                && owner.check(request_id.connection_id, session).is_ok()
+        });
+        // Both original locks remain held through the actual permit.send below.
+        let qualification = if current {
+            manager.xiaok_lock_current_snapshot(&snapshot).ok()
+        } else {
+            None
+        };
+        let current = qualification.is_some()
+            && owner.check(request_id.connection_id, session).is_ok()
+            && context
+                .as_ref()
+                .is_some_and(|c| !c.cancellation.is_cancelled());
+        let private_auth = if current {
+            Some(codex_app_server_transport::PrivateAuthPayload::new(
+                Box::new(AuthSnapshotDelivery {
+                    snapshot,
+                    manager: Arc::clone(manager),
+                    owner: Arc::clone(owner),
+                    session: Arc::clone(session),
+                    context: context.expect("checked original context"),
+                    request_id: request_id.clone(),
+                    frame: None,
+                    offset: 0,
+                }),
+            ))
+        } else {
+            None
+        };
+        // Public placeholder never contains credentials and is never serialized
+        // by the role writer when carrying the private original delivery.
+        let message = OutgoingMessage::Error(OutgoingError {
+            id: request_id.request_id,
+            error: crate::xiaok_auth_owner::unavailable(),
+        });
+        permit.send(OutgoingEnvelope::ToConnection {
+            connection_id: request_id.connection_id,
+            message,
+            private_auth,
+            write_complete_tx: None,
+        });
+        drop(qualification);
     }
 
