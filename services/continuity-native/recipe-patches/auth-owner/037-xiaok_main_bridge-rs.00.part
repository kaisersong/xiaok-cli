+#[cfg(feature = "xiaok-auth-owner-only")]
+pub(crate) fn validate_request(request: &ClientRequest) -> Result<(), JSONRPCErrorError> {
+    #[cfg(feature = "xiaok-auth-owner-only")]
+    {
+        let wire =
+            serde_json::to_value(request).map_err(|_| crate::xiaok_auth_owner::forbidden())?;
+        return crate::xiaok_auth_owner::validate_public_wire(
+            wire["method"]
+                .as_str()
+                .ok_or_else(crate::xiaok_auth_owner::forbidden)?,
+            wire.get("params"),
+        );
+    }
+}
