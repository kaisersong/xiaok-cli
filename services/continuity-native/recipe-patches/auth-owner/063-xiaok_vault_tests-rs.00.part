+#[tokio::test]
+async fn xiaok_vault_joint_guard_holds_the_real_writer_until_original_output_boundary() {
+    let (_root, manager) = fixture(false).await;
+    let vault = manager.xiaok_vault.as_ref().unwrap();
+    let refresh = vault
+        .begin(super::super::xiaok_vault::Kind::Refresh)
+        .unwrap();
+    let mut captured = refresh.captured_auth().unwrap();
+    captured.last_refresh = Some(Utc::now());
+    let snapshot = manager.xiaok_managed_auth_snapshot().unwrap();
+    let guard = manager.xiaok_lock_current_snapshot(&snapshot).unwrap();
+    let (entered, started) = std::sync::mpsc::channel();
+    let (done, completed) = std::sync::mpsc::channel();
+    let writer = std::thread::spawn(move || {
+        entered.send(()).unwrap();
+        done.send(refresh.save(&captured)).unwrap();
+    });
+    started.recv_timeout(Duration::from_secs(1)).unwrap();
+    assert!(
+        matches!(
+            completed.recv_timeout(Duration::from_millis(30)),
+            Err(std::sync::mpsc::RecvTimeoutError::Timeout)
+        ),
+        "the original file writer must wait while the same guard used by permit.send is live"
+    );
+    drop(guard);
+    completed
+        .recv_timeout(Duration::from_secs(1))
+        .unwrap()
+        .unwrap();
+    writer.join().unwrap();
+    assert!(manager.xiaok_lock_current_snapshot(&snapshot).is_err());
+    manager.xiaok_reload_checked().await.unwrap();
+    assert!(
+        manager
+            .xiaok_lock_current_snapshot(&manager.xiaok_managed_auth_snapshot().unwrap())
+            .is_ok()
+    );
+}
+
+#[tokio::test]
+#[serial(auth_env)]
+async fn xiaok_vault_real_held_revoke_http_cannot_delete_new_original_login() {
+    let server = MockServer::start().await;
+    // The original revoke endpoint derives from this exact loopback override.
+    let _env = RefreshEndpoint::set(&server);
+    assert!(std::env::var_os(REVOKE_TOKEN_URL_OVERRIDE_ENV_VAR).is_none());
+    Mock::given(method("POST"))
+        .and(path("/oauth/revoke"))
+        .respond_with(ResponseTemplate::new(200).set_delay(Duration::from_millis(200)))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let (root, manager) = fixture(false).await;
+    let captured = Arc::clone(&manager);
+    let request = tokio::spawn(async move { captured.logout_with_revoke().await });
+    refresh_entered(&server).await;
+    persist(
+        root.path(),
+        manager.xiaok_begin_login().unwrap(),
+        "b",
+        false,
+    )
+    .await
+    .unwrap();
+    let committed = std::fs::read(root.path().join("auth.json")).unwrap();
+    assert!(
+        timeout(Duration::from_secs(2), request)
+            .await
+            .unwrap()
+            .unwrap()
+            .is_err()
+    );
+    assert_eq!(
+        std::fs::read(root.path().join("auth.json")).unwrap(),
+        committed
+    );
+    manager.xiaok_reload_checked().await.unwrap();
+    assert_eq!(
+        manager.xiaok_managed_auth_snapshot().unwrap().account_id(),
+        "account-b"
+    );
+}
+
+fn assert_real_os_lock_retained(root: &Path) {
+    let mut child = std::process::Command::new("/usr/bin/python3")
+        .args(["-c", "import fcntl,sys\nf=open(sys.argv[1],'r+b')\ntry: fcntl.flock(f,fcntl.LOCK_EX|fcntl.LOCK_NB)\nexcept BlockingIOError: sys.exit(0)\nsys.exit(7)"])
+        .arg(root.join(".xiaok-auth-vault-v1.lock"))
+        .spawn().unwrap();
+    let pid = child.id();
+    println!("owned OS lock probe PID {pid}");
+    assert!(
+        child.wait().unwrap().success(),
+        "another process must observe the real OS lock, not just the registry"
+    );
+    assert_eq!(unsafe { libc::kill(pid as i32, 0) }, -1);
+    assert_eq!(
+        std::io::Error::last_os_error().raw_os_error(),
+        Some(libc::ESRCH)
+    );
+    println!("owned OS lock probe PID {pid} reaped");
+}
+
+#[test]
+fn xiaok_vault_failed_birth_parse_retains_actual_os_lock_until_process_exit() {
+    use std::io::Write;
+    use std::os::unix::fs::OpenOptionsExt;
+    let root = tempfile::tempdir().unwrap();
+    std::fs::set_permissions(root.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+    let mut birth = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(root.path().join(".xiaok-auth-vault-v1.lock"))
+        .unwrap();
+    birth.write_all(b"SYNTHETIC_BAD_BIRTH_JSON_CANARY").unwrap();
+    drop(birth);
+    assert!(super::super::xiaok_vault::initialize_xiaok_auth_vault(root.path()).is_err());
+    assert_real_os_lock_retained(root.path());
+    assert!(super::super::xiaok_vault::initialize_xiaok_auth_vault(root.path()).is_err());
+}
+
+#[tokio::test]
+async fn xiaok_vault_checked_constructor_policy_failure_does_not_release_actual_claim() {
+    let root = tempfile::tempdir().unwrap();
+    std::fs::set_permissions(root.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+    super::super::xiaok_vault::initialize_xiaok_auth_vault(root.path()).unwrap();
+    let mut denied = config(root.path());
+    denied.forced_login_method = Some(ForcedLoginMethod::Api);
+    assert!(
+        AuthManager::shared_from_auth_config(denied, false)
+            .await
+            .is_err()
+    );
+    assert_real_os_lock_retained(root.path());
+}
+
+#[test]
+fn xiaok_vault_queued_original_spawn_blocking_save_cannot_recreate_auth_after_cancel() {
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .max_blocking_threads(1)
+        .build()
+        .unwrap();
+    runtime.block_on(async {
+        let (root, manager) = fixture(false).await;
+        let operation = manager.xiaok_begin_login().unwrap();
+        let (release, held) = std::sync::mpsc::channel();
+        let (started, entered) = std::sync::mpsc::channel();
+        let occupying = tokio::task::spawn_blocking(move || {
+            started.send(()).unwrap();
+            held.recv_timeout(Duration::from_secs(3)).unwrap();
+        });
+        entered.recv_timeout(Duration::from_secs(1)).unwrap();
+        let save = persist(root.path(), operation.clone(), "b", false);
+        tokio::pin!(save);
+        assert!(timeout(Duration::from_millis(20), &mut save).await.is_err());
+        operation.cancel(true);
+        release.send(()).unwrap();
+        occupying.await.unwrap();
+        assert!(
+            timeout(Duration::from_secs(1), save)
+                .await
+                .unwrap()
+                .is_err()
+        );
+        manager.xiaok_reload_checked().await.unwrap();
+        assert_eq!(
+            manager.xiaok_managed_auth_snapshot().unwrap().account_id(),
+            "account-a"
+        );
+    });
+}
