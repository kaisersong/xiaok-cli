diff --git a/codex-rs/app-server-protocol/src/rpc.rs b/codex-rs/app-server-protocol/src/rpc.rs
--- a/codex-rs/app-server-protocol/src/rpc.rs
+++ b/codex-rs/app-server-protocol/src/rpc.rs
@@ -48,6 +48,10 @@
     pub method: String,
     #[serde(default, skip_serializing_if = "Option::is_none")]
     #[ts(optional)]
+    #[cfg_attr(
+        feature = "xiaok-auth-owner-only",
+        serde(deserialize_with = "deserialize_xiaok_present_params")
+    )]
     pub params: Option<serde_json::Value>,
     /// Optional W3C Trace Context for distributed tracing.
     #[serde(default, skip_serializing_if = "Option::is_none")]
@@ -86,3 +90,15 @@
     pub data: Option<serde_json::Value>,
     pub message: String,
 }
+
+// Only the fixed auth-owner build distinguishes an explicit null from an
+// omitted params member. The ordinary SDK representation stays unchanged.
+#[cfg(feature = "xiaok-auth-owner-only")]
+fn deserialize_xiaok_present_params<'de, D>(
+    deserializer: D,
+) -> std::result::Result<Option<serde_json::Value>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    serde_json::Value::deserialize(deserializer).map(Some)
+}
