+        let operation = vault.begin(super::xiaok_vault::Kind::Delete)?;
+        let prior = operation.captured_optional_auth()?;
+        if revoke {
+            operation.check()?;
+            if revoke_auth_tokens(prior.as_ref(), &self.auth_route_config)
+                .await
+                .is_err()
+            {
+                tracing::warn!("Token revocation failed during logout");
+            }
+        }
+        let removed = operation.delete()?;
+        self.xiaok_reload_checked().await?;
+        Ok(removed)
     }
 }
 
