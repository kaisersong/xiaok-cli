+                let tokens = data.tokens.as_mut().unwrap();
+                match field {
+                    "account" => tokens.account_id = Some(" ".to_string()),
+                    "user" => tokens.id_token.chatgpt_user_id = None,
+                    "workspace" => tokens.id_token.chatgpt_account_id = Some("foreign".to_string()),
+                    "access" => tokens.access_token.clear(),
