+#[test]
+fn xiaok_auth_snapshot_permanent_failure_and_counter_overflow_fail_closed() {
+    let auth = managed("user-a", "account-a", "SYNTHETIC_FAILURE_CANARY");
+    let manager = AuthManager::from_auth_for_testing(auth.clone());
+    let old = manager.xiaok_managed_auth_snapshot().unwrap();
+    manager.record_permanent_refresh_failure_if_unchanged(
+        &auth,
+        &RefreshTokenFailedError::new(RefreshTokenFailedReason::Other, "synthetic".to_string()),
+    );
+    assert!(manager.xiaok_managed_auth_snapshot().is_err());
+    assert!(manager.xiaok_assert_snapshot_current(&old).is_err());
+    manager.set_cached_auth(Some(managed(
+        "user-a",
+        "account-a",
+        "SYNTHETIC_RECOVERED_CANARY",
+    )));
+    manager.inner.write().unwrap().change_state.generation = u64::MAX;
+    manager.set_cached_auth(Some(managed(
+        "user-a",
+        "account-a",
+        "SYNTHETIC_OVERFLOW_CANARY",
+    )));
+    assert!(manager.xiaok_managed_auth_snapshot().is_err());
+    assert!(manager.xiaok_assert_snapshot_current(&old).is_err());
+}
+
+#[test]
+fn xiaok_auth_snapshot_waits_for_original_inner_write_and_watch_publish() {
+    let manager = AuthManager::from_auth_for_testing(managed(
+        "user-a",
+        "account-a",
+        "SYNTHETIC_BEFORE_CANARY",
+    ));
+    let receiver = manager.auth_change_state_receiver();
+    let held_watch = receiver.borrow();
+    let writer_manager = manager.clone();
+    let writer = thread::spawn(move || {
+        writer_manager.set_cached_auth(Some(managed(
+            "user-b",
+            "account-b",
+            "SYNTHETIC_AFTER_CANARY",
+        )))
+    });
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while manager.inner.try_read().is_ok() {
+        assert!(Instant::now() < deadline);
+        thread::yield_now();
+    }
+    let (tx, rx) = mpsc::channel();
+    let reader_manager = manager.clone();
+    let reader = thread::spawn(move || {
+        tx.send(reader_manager.xiaok_managed_auth_snapshot())
+            .unwrap()
+    });
+    assert!(matches!(
+        rx.recv_timeout(Duration::from_millis(30)),
+        Err(mpsc::RecvTimeoutError::Timeout)
+    ));
+    drop(held_watch);
+    assert!(writer.join().unwrap());
+    let result = rx.recv_timeout(Duration::from_secs(5)).unwrap().unwrap();
+    reader.join().unwrap();
+    assert_eq!(result.account_id(), "account-b");
+    assert_eq!(result.user_id(), "user-b");
+    assert_eq!(result.credential_generation(), 1);
+    assert_eq!(result.owner_generation(), 1);
+}
