+use super::*;
+use base64::Engine;
+use std::sync::mpsc;
+use std::thread;
+
+fn managed(user: &str, account: &str, token: &str) -> CodexAuth {
+    let claims = serde_json::json!({"https://api.openai.com/auth":{"chatgpt_user_id":user,"chatgpt_account_id":account},"jti":token});
+    let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(claims.to_string());
+    let CodexAuth::ChatgptAuthTokens(external) = CodexAuth::from_external_chatgpt_tokens(
+        &format!("header.{payload}.signature"),
+        account,
+        None,
+    )
+    .unwrap() else {
+        panic!("fixture mode");
+    };
+    {
+        let mut value = external.state.auth_dot_json.lock().unwrap();
+        let data = value.as_mut().unwrap();
+        data.auth_mode = Some(AuthMode::Chatgpt);
+        data.tokens.as_mut().unwrap().id_token.chatgpt_account_id = Some(account.to_string());
+    }
+    CodexAuth::Chatgpt(ChatgptAuth {
+        state: external.state,
+        storage: create_auth_storage(
+            PathBuf::from("xiaok-synthetic-private-memory-only"),
+            AuthCredentialsStoreMode::Ephemeral,
+            AuthKeyringBackendKind::default(),
+        ),
+    })
+}
+
+#[test]
+fn xiaok_auth_snapshot_rejects_empty_external_and_nonmanaged_modes() {
+    let empty = AuthManager::from_optional_auth_for_testing(None);
+    assert_eq!(
+        empty.xiaok_managed_auth_snapshot().unwrap_err().to_string(),
+        "xiaok_auth_unavailable"
+    );
+    let api = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("SYNTHETIC_API_CANARY"));
+    assert!(api.xiaok_managed_auth_snapshot().is_err());
+    let CodexAuth::Chatgpt(auth) = managed("user-a", "account-a", "SYNTHETIC_ACCESS_CANARY") else {
+        unreachable!()
+    };
+    let external =
+        AuthManager::from_auth_for_testing(CodexAuth::ChatgptAuthTokens(ChatgptAuthTokens {
+            state: auth.state,
+        }));
+    assert!(external.xiaok_managed_auth_snapshot().is_err());
+}
+
+#[test]
+fn xiaok_auth_snapshot_is_one_owned_tuple_and_debug_redacts_bearer() {
+    let manager = AuthManager::from_auth_for_testing(managed(
+        "user-a",
+        "account-a",
+        "SYNTHETIC_ACCESS_CANARY",
+    ));
+    let snapshot = manager.xiaok_managed_auth_snapshot().unwrap();
+    assert_eq!(snapshot.account_id(), "account-a");
+    assert_eq!(snapshot.user_id(), "user-a");
+    assert!(snapshot.access_token().starts_with("header."));
+    assert!(!format!("{snapshot:?}").contains(snapshot.access_token()));
+    manager.xiaok_assert_snapshot_current(&snapshot).unwrap();
+    manager.set_cached_auth(Some(managed(
+        "user-a",
+        "account-a",
+        "SYNTHETIC_NEXT_CANARY",
+    )));
+    assert!(manager.xiaok_assert_snapshot_current(&snapshot).is_err());
+    let rotated = manager.xiaok_managed_auth_snapshot().unwrap();
+    assert_eq!(rotated.credential_generation(), 1);
+    assert_eq!(rotated.owner_generation(), 0);
+    manager.set_cached_auth(Some(managed(
+        "user-b",
+        "account-b",
+        "SYNTHETIC_OWNER_CANARY",
+    )));
+    assert!(manager.xiaok_assert_snapshot_current(&rotated).is_err());
+    let changed = manager.xiaok_managed_auth_snapshot().unwrap();
+    assert_eq!(changed.credential_generation(), 2);
+    assert_eq!(changed.owner_generation(), 1);
+}
+
+#[test]
+fn xiaok_auth_snapshot_nested_change_cannot_bypass_original_commit_or_revive_old_snapshot() {
+    let auth = managed("user-a", "account-a", "SYNTHETIC_OLD_CANARY");
+    let manager = AuthManager::from_auth_for_testing(auth.clone());
+    let old = manager.xiaok_managed_auth_snapshot().unwrap();
+    let CodexAuth::Chatgpt(ref value) = auth else {
+        unreachable!()
+    };
+    value
+        .state
+        .auth_dot_json
+        .lock()
+        .unwrap()
+        .as_mut()
+        .unwrap()
+        .tokens
+        .as_mut()
+        .unwrap()
+        .access_token = "SYNTHETIC_NESTED_CHANGE_CANARY".to_string();
+    assert!(manager.xiaok_managed_auth_snapshot().is_err());
+    assert!(manager.xiaok_assert_snapshot_current(&old).is_err());
+    manager.set_cached_auth(Some(auth));
+    let committed = manager.xiaok_managed_auth_snapshot().unwrap();
+    assert_eq!(committed.credential_generation(), 1);
+    assert_eq!(committed.owner_generation(), 0);
+    assert_eq!(committed.access_token(), "SYNTHETIC_NESTED_CHANGE_CANARY");
+    assert!(manager.xiaok_assert_snapshot_current(&old).is_err());
+}
