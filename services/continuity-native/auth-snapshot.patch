+#[test]
+fn xiaok_auth_snapshot_real_concurrent_owner_switch_never_mixes_token_and_account() {
+    let auth_a = managed("user-a", "account-a", "SYNTHETIC_A_CANARY");
+    let auth_b = managed("user-b", "account-b", "SYNTHETIC_B_CANARY");
+    let token_a = auth_a.get_token().unwrap();
+    let token_b = auth_b.get_token().unwrap();
+    let manager = AuthManager::from_auth_for_testing(auth_a.clone());
+    let writer_manager = manager.clone();
+    let writer = thread::spawn(move || {
+        for i in 0..500 {
+            writer_manager.set_cached_auth(Some(if i % 2 == 0 {
+                auth_b.clone()
+            } else {
+                auth_a.clone()
+            }));
+        }
+    });
+    for _ in 0..1000 {
+        let value = manager.xiaok_managed_auth_snapshot().unwrap();
+        if value.access_token() == token_a {
+            assert_eq!(value.account_id(), "account-a");
+            assert_eq!(value.user_id(), "user-a");
+        } else {
+            assert_eq!(value.access_token(), token_b);
+            assert_eq!(value.account_id(), "account-b");
+            assert_eq!(value.user_id(), "user-b");
+        }
+    }
+    writer.join().unwrap();
+}
