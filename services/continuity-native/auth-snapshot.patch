+fn xiaok_auth_snapshot_all_revision_overflows_are_sticky_without_wraparound() {
+    for field in ["credential", "owner", "legacy"] {
+        let manager = AuthManager::from_auth_for_testing(managed(
+            "user-a",
+            "account-a",
+            "SYNTHETIC_MAX_CANARY",
+        ));
+        let old = manager.xiaok_managed_auth_snapshot().unwrap();
+        match field {
+            "credential" => manager.inner.write().unwrap().change_state.generation = u64::MAX,
+            "owner" => manager.inner.write().unwrap().change_state.owner_generation = u64::MAX,
+            "legacy" => {
+                manager.auth_change_tx.send_replace(u64::MAX);
+            }
+            _ => unreachable!(),
+        }
+        manager.set_cached_auth(Some(managed(
+            "user-b",
+            "account-b",
+            "SYNTHETIC_OVERFLOW_CANARY",
+        )));
+        assert!(manager.xiaok_managed_auth_snapshot().is_err(), "{field}");
+        assert!(manager.xiaok_assert_snapshot_current(&old).is_err());
+        manager.set_cached_auth(Some(managed(
+            "user-a",
+            "account-a",
+            "SYNTHETIC_POST_MAX_CANARY",
+        )));
+        assert!(manager.xiaok_managed_auth_snapshot().is_err());
