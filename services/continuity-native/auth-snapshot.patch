+#[test]
+fn xiaok_auth_snapshot_poisoned_workspace_policy_cannot_become_unrestricted() {
+    let manager = AuthManager::from_auth_for_testing(managed(
+        "user-a",
+        "account-a",
+        "SYNTHETIC_POISON_CANARY",
+    ));
+    let old = manager.xiaok_managed_auth_snapshot().unwrap();
+    *manager.forced_chatgpt_workspace_id.write().unwrap() = Some(vec!["foreign".to_string()]);
+    assert!(manager.xiaok_managed_auth_snapshot().is_err());
+    assert!(manager.xiaok_assert_snapshot_current(&old).is_err());
+    let panic = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _guard = manager.forced_chatgpt_workspace_id.write().unwrap();
+        panic!("synthetic policy lock poison");
+    }));
+    assert!(panic.is_err());
+    assert!(
+        manager.xiaok_managed_auth_snapshot().is_err(),
+        "failed policy read must never become unrestricted"
+    );
+    assert!(manager.xiaok_assert_snapshot_current(&old).is_err());
+}
