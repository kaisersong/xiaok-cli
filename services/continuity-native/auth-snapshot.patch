+/// Owned auth-only projection. No Deserialize/Default or public constructor:
+/// a response DTO cannot manufacture an original manager snapshot.
+pub struct XiaokManagedAuthSnapshot {
+    tuple: XiaokAuthTuple,
+    pin: XiaokAuthPin,
+    state: AuthChangeState,
+    incarnation: Arc<()>,
+}
+impl Debug for XiaokManagedAuthSnapshot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("XiaokManagedAuthSnapshot")
+            .field("credential_generation", &self.state.generation)
+            .field("owner_generation", &self.state.owner_generation)
+            .finish_non_exhaustive()
+    }
+}
+impl XiaokManagedAuthSnapshot {
+    pub fn access_token(&self) -> &str {
+        &self.tuple.access_token
+    }
+    pub fn account_id(&self) -> &str {
+        &self.tuple.account_id
+    }
+    pub fn user_id(&self) -> &str {
+        &self.tuple.user_id
+    }
+    pub fn plan(&self) -> Option<&str> {
+        self.tuple.plan.as_deref()
+    }
+    pub fn credential_generation(&self) -> u64 {
+        self.state.generation
+    }
+    pub fn owner_generation(&self) -> u64 {
+        self.state.owner_generation
+    }
+}
+#[derive(Clone, PartialEq, Eq)]
+struct XiaokAuthOwner {
+    mode: &'static str,
+    account_id: String,
+    user_id: String,
+}
+#[derive(Clone, PartialEq, Eq)]
+struct XiaokAuthPin {
+    commitment: [u8; 32],
+    owner: XiaokAuthOwner,
+}
+struct XiaokAuthTuple {
+    mode: &'static str,
+    access_token: String,
+    account_id: String,
+    user_id: String,
+    plan: Option<String>,
+}
+fn xiaok_auth_unavailable() -> std::io::Error {
+    std::io::Error::other("xiaok_auth_unavailable")
+}
+fn xiaok_token_field(value: &str, limit: usize) -> std::io::Result<String> {
+    if value.is_empty()
+        || value.len() > limit
+        || value.trim() != value
+        || value.chars().any(char::is_control)
+    {
+        return Err(xiaok_auth_unavailable());
+    }
+    Ok(value.to_owned())
+}
+fn xiaok_auth_tuple(auth: &CodexAuth, managed_only: bool) -> std::io::Result<XiaokAuthTuple> {
+    let (state, mode, expected_mode) = match auth {
+        CodexAuth::Chatgpt(auth) => (&auth.state, "chatgpt", AuthMode::Chatgpt),
+        CodexAuth::ChatgptAuthTokens(auth) if !managed_only => (
+            &auth.state,
+            "chatgptAuthTokens",
+            AuthMode::ChatgptAuthTokens,
+        ),
+        _ => return Err(xiaok_auth_unavailable()),
+    };
+    // Exactly one nested acquisition for ALL exported fields. Do not call the
+    // original per-field getters while holding this Mutex.
+    let locked = state
+        .auth_dot_json
+        .lock()
+        .map_err(|_| xiaok_auth_unavailable())?;
+    let data = locked.as_ref().ok_or_else(xiaok_auth_unavailable)?;
+    if data.resolved_mode() != expected_mode || data.last_refresh.is_none() {
+        return Err(xiaok_auth_unavailable());
+    }
+    let tokens = data.tokens.as_ref().ok_or_else(xiaok_auth_unavailable)?;
+    let access_token = xiaok_token_field(&tokens.access_token, 65536)?;
+    let account_id = xiaok_token_field(
+        tokens
+            .account_id
+            .as_deref()
+            .ok_or_else(xiaok_auth_unavailable)?,
+        256,
+    )?;
+    let user_id = xiaok_token_field(
+        tokens
+            .id_token
+            .chatgpt_user_id
+            .as_deref()
+            .ok_or_else(xiaok_auth_unavailable)?,
+        256,
+    )?;
+    if tokens.id_token.chatgpt_account_id.as_deref() != Some(account_id.as_str()) {
+        return Err(xiaok_auth_unavailable());
+    }
+    let plan = tokens
+        .id_token
+        .get_chatgpt_plan_type_raw()
+        .map(|value| xiaok_token_field(&value, 256))
+        .transpose()?;
+    Ok(XiaokAuthTuple {
+        mode,
+        access_token,
+        account_id,
+        user_id,
+        plan,
+    })
+}
+impl XiaokAuthTuple {
+    fn pin(&self) -> XiaokAuthPin {
+        use sha2::Digest;
+        let encoded = serde_json::json!([
+            "xiaok/managed-auth-export-tuple/v1",
+            self.mode,
+            self.access_token,
+            self.account_id,
+            self.user_id,
+            self.plan
+        ]);
+        XiaokAuthPin {
+            commitment: sha2::Sha256::digest(encoded.to_string().as_bytes()).into(),
+            owner: XiaokAuthOwner {
+                mode: self.mode,
+                account_id: self.account_id.clone(),
+                user_id: self.user_id.clone(),
+            },
+        }
+    }
+}
+fn xiaok_committed_pin(auth: Option<&CodexAuth>) -> Option<XiaokAuthPin> {
+    auth.and_then(|auth| xiaok_auth_tuple(auth, false).ok())
+        .map(|tuple| tuple.pin())
+}
