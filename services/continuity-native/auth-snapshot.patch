+    /// Synchronous original-manager export only. A refresh is a separate
+    /// original async Result, never an implicit stale-cache fallback here.
+    pub fn xiaok_managed_auth_snapshot(&self) -> std::io::Result<XiaokManagedAuthSnapshot> {
+        let guard = self.inner.read().map_err(|_| xiaok_auth_unavailable())?;
+        let tuple = self.xiaok_current_managed_tuple(&guard)?;
+        Ok(XiaokManagedAuthSnapshot {
+            pin: tuple.pin(),
+            tuple,
+            state: guard.change_state,
+            incarnation: guard.xiaok_incarnation.clone(),
+        })
+    }
+    pub fn xiaok_assert_snapshot_current(
+        &self,
+        original: &XiaokManagedAuthSnapshot,
+    ) -> std::io::Result<()> {
+        let guard = self.inner.read().map_err(|_| xiaok_auth_unavailable())?;
+        if !Arc::ptr_eq(&guard.xiaok_incarnation, &original.incarnation)
+            || guard.change_state != original.state
+        {
+            return Err(xiaok_auth_unavailable());
+        }
+        let current = self.xiaok_current_managed_tuple(&guard)?;
+        if current.pin() != original.pin {
+            return Err(xiaok_auth_unavailable());
+        }
+        Ok(())
+    }
+    fn xiaok_current_managed_tuple(&self, guard: &CachedAuth) -> std::io::Result<XiaokAuthTuple> {
+        if guard.xiaok_counter_exhausted
+            || guard.xiaok_uncommitted.load(Ordering::SeqCst)
+            || guard.permanent_refresh_failure.is_some()
+        {
+            return Err(xiaok_auth_unavailable());
+        }
+        let auth = guard.auth.as_ref().ok_or_else(xiaok_auth_unavailable)?;
+        let tuple = xiaok_auth_tuple(auth, true).map_err(|_| {
+            if matches!(auth, CodexAuth::Chatgpt(_)) {
+                guard.xiaok_uncommitted.store(true, Ordering::SeqCst);
+            }
+            xiaok_auth_unavailable()
+        })?;
+        if guard.xiaok_export_pin.as_ref() != Some(&tuple.pin()) {
+            guard.xiaok_uncommitted.store(true, Ordering::SeqCst);
+            return Err(xiaok_auth_unavailable());
+        }
+        // Match the original login/workspace policy using this owned tuple;
+        // original getters would reacquire the nested token lock separately.
+        let forced_workspaces = self
+            .forced_chatgpt_workspace_id
+            .read()
+            .map_err(|_| xiaok_auth_unavailable())?
+            .clone();
+        let method_allowed = self.managed_auth_policy.allows_login_method(
+            ForcedLoginMethod::Chatgpt,
+            self.forced_login_method,
+            forced_workspaces.as_deref(),
+        );
+        let workspaces = self
+            .managed_auth_policy
+            .effective_chatgpt_workspaces(forced_workspaces.as_deref());
+        if !method_allowed
+            || workspaces.is_some_and(|workspaces| !workspaces.contains(&tuple.account_id))
+        {
+            return Err(xiaok_auth_unavailable());
+        }
+        Ok(tuple)
